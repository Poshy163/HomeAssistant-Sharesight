{
    "application_credentials": {
        "description": "To use the Sharesight integration, create an API application at the [Sharesight Developer Portal](https://portfolio.sharesight.com/users/api_token). Set the **Redirect URI** in your Sharesight app to your Home Assistant redirect URL (e.g. `https://my.home-assistant.io/redirect/oauth`), then enter the **Client ID** and **Client Secret** below.\n\nStandard and developer accounts have separate application registries — a standard Client ID is not valid on the developer sandbox. If you use both, add a credential for each and name them so you can tell them apart."
    },
    "config": {
        "step": {
            "pick_account_type": {
                "title": "Select Sharesight account type",
                "description": "Choose the type of Sharesight account you are connecting. Standard is correct for almost everyone. Developer accounts use Sharesight's sandbox and require separate credentials issued by Sharesight.",
                "data": {
                    "account_type": "Account type"
                },
                "data_description": {
                    "account_type": "Standard suits almost everyone. Choose Developer only if Sharesight has issued you separate sandbox credentials."
                }
            },
            "pick_implementation": {
                "title": "Select Sharesight credentials",
                "description": "Pick the application credential matching the account type you selected. A standard credential will not work on the developer sandbox, and vice versa."
            },
            "portfolio": {
                "title": "Select Portfolio",
                "description": "Select the Sharesight portfolio you want to monitor.",
                "data": {
                    "portfolio_id": "Portfolio"
                },
                "data_description": {
                    "portfolio_id": "The Sharesight portfolio Home Assistant will create a device and sensors for."
                }
            },
            "reauth_confirm": {
                "title": "Re-authenticate Sharesight",
                "description": "Your Sharesight credentials have expired or been revoked. Click submit to re-authenticate."
            }
        },
        "error": {
            "other": "An unexpected error occurred. Please check the logs and report to GitHub."
        },
        "abort": {
            "already_configured": "This Sharesight portfolio is already configured.",
            "already_in_progress": "A Sharesight configuration is already in progress.",
            "oauth_error": "OAuth authentication failed. Please try again.",
            "oauth_unauthorized": "OAuth authorisation was denied. Please try again.",
            "missing_credentials": "No application credentials configured. Please add Sharesight credentials first via Settings → Devices & Services → Application Credentials.",
            "reauth_successful": "Re-authentication was successful."
        }
    },
    "options": {
        "step": {
            "init": {
                "title": "Sharesight options",
                "description": "Configure how frequently Home Assistant polls the Sharesight API for this portfolio. Must be between 60 and 3600 seconds.",
                "data": {
                    "scan_interval": "Poll interval (seconds)",
                    "enable_lts_backfill": "Backfill portfolio value history into long-term statistics"
                },
                "data_description": {
                    "scan_interval": "How often Home Assistant polls the Sharesight API for this portfolio. Must be between 60 and 3600 seconds.",
                    "enable_lts_backfill": "On startup, import the full inception-to-today daily portfolio value series into the Portfolio value sensor's statistics. Requires the value-data endpoint to be available for your API access."
                }
            }
        }
